generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id        Int        @id @default(autoincrement())
  name      String
  type      String
  active    Boolean    @default(true)
  checkouts Checkout[]
}

model Checkout {
  id             Int       @id @default(autoincrement())
  deviceId       Int
  device         Device    @relation(fields: [deviceId], references: [id])
  playerName     String
  accessoriesOk  Boolean   @default(true)
  conditionOk    Boolean   @default(true)
  checkedOutAt   DateTime  @default(now())
  returnedAt     DateTime?
}
